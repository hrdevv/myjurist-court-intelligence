# Supabase project configuration.
# Use deployment secrets for real values; do not commit populated secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Lovable AI transcription service.
LOVABLE_API_KEY=

# Explicit opt-in for mock/demo-backed legal outputs.
# Leave empty/disabled in production.
# Set to "enabled" only for prototype/demo environments.
VITE_DEMO_LEGAL_OUTPUTS=

# Optional escape hatch for isolated demo builds only.
# Never set this in production.
VITE_ALLOW_DEMO_LEGAL_OUTPUTS_IN_BUILD=
